"use client";

import { useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import { api, getAdminToken, clearAdminToken } from "../src/lib/api";

type Metrics = {
  tenantsActive?: number;
  employeesActive?: number;
  timeEntriesToday?: number;
  revenueMonthlyEstimated?: number;

  // opcional: qualquer coisa extra que o backend mandar
  [k: string]: any;
};

function formatBRL(v: any) {
  const n = Number(v);
  if (!Number.isFinite(n)) return "—";
  return n.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
}

export default function Dashboard() {
  const router = useRouter();

  const [loading, setLoading] = useState(true);
  const [err, setErr] = useState("");
  const [metrics, setMetrics] = useState<Metrics | null>(null);
  const [refreshing, setRefreshing] = useState(false);
  const [lastUpdated, setLastUpdated] = useState<string>("");

  async function load() {
    setRefreshing(true);
    setErr("");
    setLoading(true);

    const token = getAdminToken();
    if (!token) {
      router.replace("/login");
      return;
    }

    const res = await api("/dashboard/metrics");

    if (!res.ok) {
      if (res.status === 401) {
        clearAdminToken();
        router.replace("/login");
        return;
      }
      setErr(res.data?.message || "Falha ao carregar métricas");
      setLoading(false);
      setRefreshing(false);
      return;
    }

    setLastUpdated(new Date().toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" }));
    // aceita dois formatos: { ok:true, data:{...} } ou direto {...}
    const payload = res.data?.data ?? res.data;
    setMetrics(payload || null);
    setLoading(false);
  }

  useEffect(() => {
    load();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const cards = useMemo(() => {
    const m = metrics || {};
    return [
      {
        label: "Tenants ativos",
        value: m.tenantsActive ?? "—",
        hint: "dados reais",
      },
      {
        label: "Funcionários ativos",
        value: m.employeesActive ?? "—",
        hint: "dados reais",
      },
      {
        label: "Registros hoje",
        value: m.timeEntriesToday ?? "—",
        hint: "tempo real",
      },
      {
        label: "Receita mensal (estimada)",
        value: formatBRL(m.revenueMonthlyEstimated),
        hint: "modelo híbrido",
      },
    ];
  }, [metrics]);

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h1 className="text-2xl sm:text-3xl font-semibold tracking-tight text-slate-100">
            Dashboard Global
          </h1>
          <p className="text-sm text-slate-400">Visão geral do SmartPonto (Admin Global).</p>
          <p className="text-xs text-slate-500 mt-1">
              Última atualização: <span className="font-mono text-slate-300">{lastUpdated || "—"}</span>
          </p>
        </div>

        <div className="flex items-center gap-2">
          <span className="inline-flex items-center gap-2 rounded-full border border-slate-800 bg-slate-900 px-3 py-1.5 text-sm text-slate-200">
            <span className="h-2 w-2 rounded-full bg-emerald-500" />
            Plataforma online
          </span>

          <button
            onClick={() => router.push("/tenants")}
            className="inline-flex items-center justify-center rounded-xl bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700"
          >
            Ver tenants
          </button>
        </div>
      </div>

      {err ? (
        <div className="rounded-2xl border border-red-900/40 bg-red-950/40 p-4 text-sm text-red-200">
          {err}
        </div>
      ) : null}

      {/* Cards */}
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {cards.map((c) => (
          <div
            key={c.label}
            className="rounded-2xl border border-slate-800 bg-slate-900/40 p-5 shadow-[0_10px_40px_rgba(0,0,0,0.35)]"
          >
            <p className="text-sm text-slate-400">{c.label}</p>
            <div className="mt-2 flex items-end justify-between">
              <h2 className="text-3xl font-semibold text-slate-100">
                {loading ? "…" : c.value}
              </h2>
              <span className="text-xs font-medium text-slate-300 bg-slate-950 border border-slate-800 rounded-full px-2 py-1">
                {c.hint}
              </span>
            </div>
          </div>
        ))}
      </div>

      {/* Conteúdo principal */}
      <div className="grid grid-cols-1 gap-4 xl:grid-cols-3">
        {/* Crescimento / JSON */}
        <div className="xl:col-span-2 rounded-2xl border border-slate-800 bg-slate-900/40 p-6 shadow-[0_10px_40px_rgba(0,0,0,0.35)]">
          <div className="flex items-center justify-between">
            <div>
              <h3 className="text-base font-semibold text-slate-100">
                Métricas (ao vivo)
              </h3>
              <p className="text-sm text-slate-400">
                Agora já está puxando do endpoint{" "}
                <span className="font-mono text-slate-200">/api/dashboard/metrics</span>
              </p>
            </div>

            <button
              onClick={load}
              disabled={refreshing}
              className="rounded-xl border border-slate-800 bg-slate-950 px-4 py-2 text-sm font-semibold hover:bg-slate-900 transition text-slate-100 disabled:opacity-60 disabled:cursor-not-allowed"
              >
             {refreshing ? "Atualizando..." : "Atualizar"}
            </button>
          </div>

          <div className="mt-5 rounded-2xl border border-slate-800 bg-slate-950 p-4 overflow-auto">
            <pre className="text-xs text-slate-200">
              {loading ? "Carregando..." : JSON.stringify(metrics, null, 2)}
            </pre>
          </div>
        </div>

        {/* Valor comercial */}
        <div className="rounded-2xl border border-slate-800 bg-slate-900/40 p-6 shadow-[0_10px_40px_rgba(0,0,0,0.35)]">
          <h3 className="text-base font-semibold text-slate-100">
            Valor comercial (o que vende)
          </h3>
          <p className="mt-1 text-sm text-slate-400">
            Mostrar resultado rápido pro cliente em 3 minutos.
          </p>

          <ul className="mt-4 space-y-3">
            <li className="flex items-start gap-3">
              <span className="mt-0.5 inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-950 border border-emerald-900 text-emerald-300 text-sm">
                ✓
              </span>
              <div>
                <p className="text-sm font-medium text-slate-100">
                  Fechamento mensal automático
                </p>
                <p className="text-sm text-slate-400">
                  Snapshot persistido e travado após o fechamento.
                </p>
              </div>
            </li>

            <li className="flex items-start gap-3">
              <span className="mt-0.5 inline-flex h-6 w-6 items-center justify-center rounded-full bg-blue-950 border border-blue-900 text-blue-300 text-sm">
                ⏱
              </span>
              <div>
                <p className="text-sm font-medium text-slate-100">
                  Controle de inconsistências
                </p>
                <p className="text-sm text-slate-400">
                  Reduz risco e passivo trabalhista.
                </p>
              </div>
            </li>

            <li className="flex items-start gap-3">
              <span className="mt-0.5 inline-flex h-6 w-6 items-center justify-center rounded-full bg-amber-950 border border-amber-900 text-amber-300 text-sm">
                💰
              </span>
              <div>
                <p className="text-sm font-medium text-slate-100">
                  Modelo SaaS escalável
                </p>
                <p className="text-sm text-slate-400">
                  Planos por empresa + limite de funcionários (híbrido).
                </p>
              </div>
            </li>
          </ul>

          <div className="mt-6 grid gap-2">
            <button
              onClick={() => router.push("/tenants")}
              className="w-full rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700"
            >
              Gerenciar tenants
            </button>

            <button
              onClick={() => {
                clearAdminToken();
                router.replace("/login");
              }}
              className="w-full rounded-xl border border-slate-800 bg-slate-950 px-4 py-2.5 text-sm font-medium text-slate-100 hover:bg-slate-900"
            >
              Sair
            </button>
          </div>
        </div>
      </div>

      <div className="text-xs text-slate-500">
        SmartPonto Admin • Ciclo 2 (Visual + Venda)
      </div>
    </div>
  );
}