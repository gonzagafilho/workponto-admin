"use client";

import { useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import { api, clearAdminToken, getAdminToken } from "../../src/lib/api";

type Tenant = {
  id: string;
  name: string;
  slug: string;
  createdAt: string;
  isActive?: boolean;
};

export default function TenantsPage() {
  const router = useRouter();

  const [loading, setLoading] = useState(true);
  const [tenants, setTenants] = useState<Tenant[]>([]);
  const [err, setErr] = useState<string>("");

  // create tenant
  const [tenantName, setTenantName] = useState("");
  const [tenantSlug, setTenantSlug] = useState("");
  const [adminName, setAdminName] = useState("");
  const [adminEmail, setAdminEmail] = useState("");
  const [adminPassword, setAdminPassword] = useState("");

  // actions loading
  const [busyId, setBusyId] = useState<string | null>(null);

  // 🔎 Busca
  const [search, setSearch] = useState("");

  // reset password modal
  const [resetOpen, setResetOpen] = useState(false);
  const [resetTenant, setResetTenant] = useState<Tenant | null>(null);
  const [newPassword, setNewPassword] = useState("");
  const [resetBusy, setResetBusy] = useState(false);

  const canCreate = useMemo(() => {
    return tenantName && tenantSlug && adminName && adminEmail && adminPassword;
  }, [tenantName, tenantSlug, adminName, adminEmail, adminPassword]);

  // 🔎 Filtro de busca (fora de funções)
  const filtered = useMemo(() => {
    const q = search.trim().toLowerCase();
    if (!q) return tenants;

    return tenants.filter(
      (t) =>
        (t.name || "").toLowerCase().includes(q) ||
        (t.slug || "").toLowerCase().includes(q)
    );
  }, [search, tenants]);

  async function load() {
    setErr("");
    setLoading(true);

    const token = getAdminToken();
    if (!token) {
      router.replace("/login");
      return;
    }

    const res = await api("/admin/tenants");
    if (!res.ok) {
      if (res.status === 401) {
        clearAdminToken();
        router.replace("/login");
        return;
      }
      setErr(res.data?.message || "Falha ao carregar tenants");
      setLoading(false);
      return;
    }

    setTenants(res.data.tenants || []);
    setLoading(false);
  }

  useEffect(() => {
    load();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  async function createTenant(e: React.FormEvent) {
    e.preventDefault();
    setErr("");

    const payload = {
      tenantName,
      tenantSlug,
      adminName,
      adminEmail,
      adminPassword,
    };

    const res = await api("/admin/tenants", {
      method: "POST",
      body: JSON.stringify(payload),
    });

    if (!res.ok) {
      setErr(res.data?.message || "Falha ao criar tenant");
      return;
    }

    setTenantName("");
    setTenantSlug("");
    setAdminName("");
    setAdminEmail("");
    setAdminPassword("");

    await load();
  }

  function logout() {
    clearAdminToken();
    router.replace("/login");
  }

  // ✅ Toggle isActive
  async function setTenantActive(tenantId: string, isActive: boolean) {
    setErr("");
    setBusyId(tenantId);

    // ✅ confirmar antes de desativar
    if (!isActive) {
      const ok = confirm(
        "Tem certeza que deseja DESATIVAR este tenant? Isso vai bloquear login do cliente."
      );
      if (!ok) {
        setBusyId(null);
        return;
      }
    }

    const res = await api(`/admin/tenants/${tenantId}/active`, {
      method: "PATCH",
      body: JSON.stringify({ isActive }),
    });

    setBusyId(null);

    if (!res.ok) {
      setErr(res.data?.message || "Falha ao atualizar status do tenant");
      return;
    }

    // update local list
    const updated = res.data?.data;
    setTenants((prev) =>
      prev.map((t) =>
        t.id === tenantId ? { ...t, isActive: updated?.isActive ?? isActive } : t
      )
    );
  }

  // ✅ Reset admin password
  function openReset(t: Tenant) {
    setResetTenant(t);
    setNewPassword("");
    setResetOpen(true);
  }

  function closeReset() {
    setResetOpen(false);
    setResetTenant(null);
    setNewPassword("");
    setResetBusy(false);
  }

  async function submitReset() {
    if (!resetTenant) return;
    if (!newPassword || newPassword.length < 8) {
      setErr("A senha precisa ter no mínimo 8 caracteres.");
      return;
    }

    setErr("");
    setResetBusy(true);

    const res = await api(
      `/admin/tenants/${resetTenant.id}/reset-admin-password`,
      {
        method: "POST",
        body: JSON.stringify({ newPassword }),
      }
    );

    setResetBusy(false);

    if (!res.ok) {
      setErr(res.data?.message || "Falha ao resetar senha do admin do tenant");
      return;
    }

    closeReset();
  }

  return (
    <div className="min-h-screen">
      <div className="mx-auto w-full max-w-7xl px-6 py-8">
        {/* TOP BAR */}
        <div className="flex items-start justify-between gap-4">
          <div>
            <h1 className="text-3xl font-extrabold tracking-tight">
              Tenants (Empresas)
            </h1>
            <p className="mt-1 text-sm text-slate-400">
              Listagem e criação de clientes do SaaS (Admin Global).
            </p>
          </div>

          <div className="flex items-center gap-2">
            <button
              onClick={load}
              className="rounded-xl border border-slate-800 bg-slate-900 px-4 py-2 text-sm font-semibold hover:bg-slate-800 transition"
            >
              Atualizar
            </button>
            <button
              onClick={logout}
              className="rounded-xl border border-slate-800 bg-slate-900 px-4 py-2 text-sm font-semibold hover:bg-slate-800 transition"
            >
              Sair
            </button>
          </div>
        </div>

        {/* ERROR */}
        {err ? (
          <div className="mt-6 rounded-2xl border border-red-900/40 bg-red-950/40 p-4 text-sm text-red-200">
            {err}
          </div>
        ) : null}

        {/* GRID */}
        <div className="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
          {/* LIST */}
          <div className="lg:col-span-2 rounded-3xl border border-slate-800 bg-slate-900/40 p-6 shadow-[0_10px_40px_rgba(0,0,0,0.35)]">
            <div className="flex items-center justify-between">
              <h2 className="text-lg font-extrabold">Tenants cadastrados</h2>

              <div className="text-xs text-slate-400">
                Endpoint:{" "}
                <span className="font-mono text-slate-300">
                  /api/admin/tenants
                </span>
              </div>
            </div>

            {/* BUSCA + CONTADOR */}
            <div className="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div className="text-sm text-slate-400">
                Total:{" "}
                <span className="font-semibold text-slate-200">
                  {tenants.length}
                </span>
                {search.trim() ? (
                  <>
                    {" "}
                    • Filtrados:{" "}
                    <span className="font-semibold text-slate-200">
                      {filtered.length}
                    </span>
                  </>
                ) : null}
              </div>

              <input
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="Buscar por nome ou slug..."
                className="w-full sm:w-72 rounded-2xl border border-slate-800 bg-slate-950/40 px-4 py-2 text-sm text-slate-100 outline-none placeholder:text-slate-600 focus:border-slate-600"
              />
            </div>

            <div className="mt-4">
              {loading ? (
                <div className="text-sm text-slate-400">Carregando...</div>
              ) : tenants.length === 0 ? (
                <div className="text-sm text-slate-400">
                  Nenhum tenant encontrado.
                </div>
              ) : filtered.length === 0 ? (
                <div className="text-sm text-slate-400">
                  Nenhum tenant corresponde à busca.
                </div>
              ) : (
                <div className="overflow-x-auto rounded-2xl border border-slate-800">
                  <table className="w-full text-[15px]">
                    <thead className="bg-slate-950/40 text-left text-slate-400">
                      <tr>
                        <th className="px-4 py-4">Nome</th>
                        <th className="px-4 py-4">Slug</th>
                        <th className="px-4 py-4">Criado</th>
                        <th className="px-4 py-4">Status</th>
                        <th className="px-4 py-4">Ações</th>
                      </tr>
                    </thead>

                    <tbody>
                      {filtered.map((t) => {
                        const active = t.isActive ?? true;
                        const busy = busyId === t.id;

                        return (
                          <tr key={t.id} className="border-t border-slate-800">
                            <td className="px-4 py-4 font-semibold text-slate-100">
                              {t.name}
                            </td>
                            <td className="px-4 py-4 font-mono text-slate-300">
                              {t.slug}
                            </td>
                            <td className="px-4 py-4 text-slate-300">
                              {new Date(t.createdAt).toLocaleString()}
                            </td>

                            <td className="px-4 py-4">
                              {active ? (
                                <span className="inline-flex items-center gap-2 rounded-full bg-emerald-500/15 px-3 py-1 text-xs font-bold text-emerald-300">
                                  <span className="h-2 w-2 rounded-full bg-emerald-400" />
                                  Ativo
                                </span>
                              ) : (
                                <span className="inline-flex items-center gap-2 rounded-full bg-red-500/15 px-3 py-1 text-xs font-bold text-red-300">
                                  <span className="h-2 w-2 rounded-full bg-red-400" />
                                  Inativo
                                </span>
                              )}
                            </td>

                            <td className="px-4 py-4">
                              <div className="flex flex-wrap items-center gap-2">
                                <button
                                  disabled={busy}
                                  onClick={() => setTenantActive(t.id, !active)}
                                  className={`rounded-xl px-4 py-2.5 text-sm font-bold transition border ${
                                    active
                                      ? "border-red-900/40 bg-red-950/40 text-red-200 hover:bg-red-950/70"
                                      : "border-emerald-900/40 bg-emerald-950/40 text-emerald-200 hover:bg-emerald-950/70"
                                  } ${
                                    busy ? "opacity-60 cursor-not-allowed" : ""
                                  }`}
                                  title="Ativar/Desativar tenant"
                                >
                                  {busy
                                    ? "Aguarde..."
                                    : active
                                    ? "Desativar"
                                    : "Ativar"}
                                </button>

                                <button
                                  onClick={() => openReset(t)}
                                  className="rounded-xl border border-slate-700 bg-slate-950/40 px-4 py-2.5 text-sm font-bold text-slate-200 hover:bg-slate-950/70 transition"
                                >
                                  Reset Senha Admin
                                </button>

                                <span className="hidden md:inline text-xs text-slate-500 font-mono">
                                  {t.id}
                                </span>
                              </div>
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>

          {/* CREATE */}
          <div className="rounded-3xl border border-slate-800 bg-slate-900/40 p-6 shadow-[0_10px_40px_rgba(0,0,0,0.35)]">
            <h2 className="text-lg font-extrabold">Criar novo tenant</h2>
            <p className="mt-1 text-sm text-slate-400">
              Cria a empresa e já cria o usuário{" "}
              <span className="font-mono text-slate-300">TENANT_ADMIN</span>.
            </p>

            <form onSubmit={createTenant} className="mt-5 space-y-4">
              <div>
                <label className="text-sm font-semibold text-slate-200">
                  Nome da empresa
                </label>
                <input
                  value={tenantName}
                  onChange={(e) => setTenantName(e.target.value)}
                  className="mt-2 w-full rounded-2xl border border-slate-800 bg-slate-950/40 px-4 py-3 text-sm outline-none focus:border-slate-600"
                  placeholder="Ex: Cliente Gamma"
                />
              </div>

              <div>
                <label className="text-sm font-semibold text-slate-200">
                  Slug
                </label>
                <input
                  value={tenantSlug}
                  onChange={(e) => setTenantSlug(e.target.value)}
                  className="mt-2 w-full rounded-2xl border border-slate-800 bg-slate-950/40 px-4 py-3 text-sm outline-none focus:border-slate-600"
                  placeholder="cliente-x"
                />
                <div className="mt-2 text-xs text-slate-400">
                  minúsculo, sem espaços (ex:{" "}
                  <span className="font-mono text-slate-300">cliente-x</span>)
                </div>
              </div>

              <div className="pt-2 text-sm font-extrabold text-slate-200">
                Admin do tenant
              </div>

              <div>
                <label className="text-sm font-semibold text-slate-200">
                  Nome
                </label>
                <input
                  value={adminName}
                  onChange={(e) => setAdminName(e.target.value)}
                  className="mt-2 w-full rounded-2xl border border-slate-800 bg-slate-950/40 px-4 py-3 text-sm outline-none focus:border-slate-600"
                  placeholder="Admin Cliente"
                />
              </div>

              <div>
                <label className="text-sm font-semibold text-slate-200">
                  Email
                </label>
                <input
                  value={adminEmail}
                  onChange={(e) => setAdminEmail(e.target.value)}
                  className="mt-2 w-full rounded-2xl border border-slate-800 bg-slate-950/40 px-4 py-3 text-sm outline-none focus:border-slate-600"
                  placeholder="admin@cliente.com"
                />
              </div>

              <div>
                <label className="text-sm font-semibold text-slate-200">
                  Senha
                </label>
                <input
                  value={adminPassword}
                  onChange={(e) => setAdminPassword(e.target.value)}
                  type="password"
                  className="mt-2 w-full rounded-2xl border border-slate-800 bg-slate-950/40 px-4 py-3 text-sm outline-none focus:border-slate-600"
                  placeholder="Senha forte..."
                />
              </div>

              <button
                disabled={!canCreate}
                className={`w-full rounded-2xl px-4 py-3 text-sm font-extrabold transition ${
                  canCreate
                    ? "bg-indigo-600 hover:bg-indigo-500 text-white"
                    : "bg-slate-800 text-slate-500 cursor-not-allowed"
                }`}
              >
                Criar tenant
              </button>
            </form>
          </div>
        </div>
      </div>

      {/* MODAL RESET PASSWORD */}
      {resetOpen && resetTenant ? (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-6">
          <div className="w-full max-w-lg rounded-3xl border border-slate-800 bg-slate-950 p-6 shadow-[0_30px_80px_rgba(0,0,0,0.6)]">
            <div className="flex items-start justify-between gap-3">
              <div>
                <h3 className="text-lg font-extrabold">Reset senha do admin</h3>
                <p className="mt-1 text-sm text-slate-400">
                  Tenant:{" "}
                  <span className="font-mono text-slate-200">
                    {resetTenant.slug}
                  </span>
                </p>
              </div>

              <button
                onClick={closeReset}
                className="rounded-xl border border-slate-800 bg-slate-900 px-4 py-2.5 text-sm font-bold hover:bg-slate-800 transition"
              >
                Fechar
              </button>
            </div>

            <div className="mt-5">
              <label className="text-sm font-semibold text-slate-200">
                Nova senha (mínimo 8)
              </label>
              <input
                value={newPassword}
                onChange={(e) => setNewPassword(e.target.value)}
                type="password"
                className="mt-2 w-full rounded-2xl border border-slate-800 bg-slate-900/40 px-4 py-3 text-sm outline-none focus:border-slate-600"
                placeholder="NovaSenhaForte@123"
              />
            </div>

            <div className="mt-6 flex items-center justify-end gap-2">
              <button
                onClick={closeReset}
                className="rounded-2xl border border-slate-800 bg-slate-900 px-4 py-3 text-sm font-bold hover:bg-slate-800 transition"
              >
                Cancelar
              </button>
              <button
                onClick={submitReset}
                disabled={resetBusy || newPassword.length < 8}
                className={`rounded-2xl px-4 py-3 text-sm font-extrabold transition ${
                  resetBusy || newPassword.length < 8
                    ? "bg-slate-800 text-slate-500 cursor-not-allowed"
                    : "bg-emerald-600 hover:bg-emerald-500 text-white"
                }`}
              >
                {resetBusy ? "Aguarde..." : "Resetar senha"}
              </button>
            </div>
          </div>
        </div>
      ) : null}
    </div>
  );
}